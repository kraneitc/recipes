---
layout: layouts/base.njk
title: Recipes
description: Browse the personal recipe collection.
permalink: /index.html
---

<section class="collection-header">
  <p class="eyebrow">Personal cookbook</p>
  <h1>Mise en place</h1>
  <p class="pronunciation">Pronounced “meez ahn plahs”.</p>
  <p>Find a recipe to cook on its own, or explore meals and menus that bring several dishes together.</p>
</section>

{% if collections.recipes.length %}
  <ul class="recipe-grid">
    {% for recipe in collections.recipes %}
      <li>
        <article class="recipe-card">
          <p class="recipe-status">{{ recipe.data.status }}</p>
          <h2><a href="{{ recipe.url | url }}">{{ recipe.data.title }}</a></h2>
          <p>{{ recipe.data.description }}</p>
          <p class="recipe-card-meta">
            {% if recipe.data.servings %}{{ recipe.data.servings }} servings{% else %}{{ recipe.data.yield }}{% endif %}
            <span aria-hidden="true">·</span>
            {{ (recipe.data.prep_minutes + recipe.data.cook_minutes) | formatMinutes }} total
          </p>
        </article>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <section class="empty-state">
    <h2>No recipes yet</h2>
    <p>Copy <code>templates/recipe.md</code> into a new folder under <code>recipes/</code> to add the first recipe.</p>
  </section>
{% endif %}

{% if collections.meals.length %}
  <section class="collection-section" aria-labelledby="meals-heading">
    <header class="collection-header">
      <p class="eyebrow">Batch cooking</p>
      <h2 id="meals-heading">Meals</h2>
      <p>Coordinated recipes portioned and stored together for easy serving.</p>
    </header>
    <ul class="recipe-grid">
      {% for meal in collections.meals %}
        <li>
          <article class="recipe-card">
            <p class="recipe-status">Meal</p>
            <h3><a href="{{ meal.url | url }}">{{ meal.data.title }}</a></h3>
            <p>{{ meal.data.description }}</p>
            <p class="recipe-card-meta">{{ meal.data.yield }}</p>
          </article>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
